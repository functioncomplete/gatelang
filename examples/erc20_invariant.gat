// ============================================================================
// ERC-20 全局不变量的有界验证：Σ balances == totalSupply
// ============================================================================
//
// ## 为什么需要"有界"
//
// GateLang 是**纯计算**语言，没有 `mapping(address => uint256)` 原生类型。
// 全局不变量 `Σ balances == totalSupply`（CertiK/Certora 公开属性 INV-01）
// 在地址空间无界时需要**归纳证明**（对应流水线文档的 Lean 4 后端）。
//
// 标准的**有界验证**做法（Certora 的参数化规则、KEVM 的有界证明都如此）：
// 把地址域限制为有限的 N 个账户，用 N 个显式寄存器建模 storage。
// 于是该不变量成为**可判定命题**，"转账保持该不变量"成为一个全称量化的
// 一步归纳：对**全部** 256 位余额与金额成立（不是抽样）。
//
// 配合初始状态 (0, 0, 0) 满足不变量，即得归纳不变量的安全性。
//
// ## 本次证明的范围（诚实声明）
//
// ✅ **已证明**：N = 2 账户、**真实 uint256 位宽**下的不变量保持（`ERC20Step2`），
//    以及其算术内核"同一笔金额加减相消"（`AmountCancels256`）。
// ✅ **已证明**：N = 4 账户在 Bits<8> 下的不变量保持
//    （见 `erc20_invariant_small.gat`），说明多账户情形本身可判定。
// ❌ **未证明**：N ≥ 4 且位宽 ≥ 16 的不变量保持。原因**不是位宽**，而是
//    SAT 对**多项重结合**（`(b0-a)+b1+b2+b3` vs `(b0+b1+b2+b3)-a`）的固有弱点。
//    实测扩展性：N=4 在 Bits<8> 需 4 秒，Bits<12> 已超 120 秒。
//    详见《GateLang ERC-20 形式化验证报告》第 7 节。

// ---------------------------------------------------------------------------
// N = 2 账户的 ERC-20 状态模型（uint256）
// 状态：2 个余额寄存器 + 总供应量。等价于把 mapping 限制在 2 个地址上。
// ---------------------------------------------------------------------------
circuit ERC20Inv2(b0: Bits<256>, b1: Bits<256>, total: Bits<256>) -> (ok: Bit) {
    ok = (b0 + b1) == total;
    return ok;
}

// ---------------------------------------------------------------------------
// transfer(0 → 1, amount)：不变量**保持**
//
// `violation = invBefore ∧ ¬invAfter`；`violation == 0` 被证明，
// 等价于"对全部 2^768 组输入，只要转账前不变量成立，转账后仍然成立"。
// 这就是归纳步。
// ---------------------------------------------------------------------------
circuit ERC20Step2(
    b0: Bits<256>, b1: Bits<256>, total: Bits<256>, amount: Bits<256>
) -> (violation: Bit) {
    invBefore = (b0 + b1) == total;
    n0 = b0 - amount;
    n1 = b1 + amount;
    invAfter = (n0 + n1) == total;
    violation = AND(invBefore, NOT(invAfter));
    return violation;
}

spec FCT.erc20.ERC20Step2 {
    precondition: true;
    postcondition: violation == 0;
    invariant: true;
}

// ---------------------------------------------------------------------------
// 核心引理：同一笔金额的加减相消（uint256）
//
// `(x - a) + (y + a) == x + y`
//
// 这是不变量保持的**算术内核**，单独证明的价值：
//   1. 失败时能区分"更新逻辑错"与"算术内核错"；
//   2. 可作为可复用的证明单元（流水线文档 §6.2「证明复用」的雏形：
//      任何用到同额加减的协议都能引用这条已证引理）。
// ---------------------------------------------------------------------------
circuit AmountCancels256(x: Bits<256>, y: Bits<256>, amount: Bits<256>) -> (ok: Bit) {
    lhs = (x - amount) + (y + amount);
    rhs = x + y;
    ok = lhs == rhs;
    return ok;
}

spec FCT.erc20.AmountCancels256 {
    precondition: true;
    postcondition: ok == 1;
    invariant: true;
}
