// 半加器（白皮书 v2.2 §4.2）
// 本实现用门级原语 XOR(4)+AND(2) = 6 门（不共享 t）。
// 共享 t 的 5 门实现见 halfadder.gat 的 HalfAdder5。
circuit HalfAdder(a: Bit, b: Bit) -> (sum: Bit, carry: Bit) {
    sum = XOR(a, b);
    carry = AND(a, b);
    return (sum, carry);
}

// 4 位加法器：s = (a + b) mod 2^4，60 门
circuit Adder4(a: Bits<4>, b: Bits<4>) -> (s: Bits<4>) {
    s = a + b;
    return (s);
}