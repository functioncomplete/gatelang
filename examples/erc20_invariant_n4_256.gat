// ============================================================================
// N = 4 账户不变量保持 @ 真实 uint256 —— 词级重写层的**核心验收场景**
// ============================================================================
//
// ## 为什么这个文件最重要
//
// 《GateLang ERC-20 形式化验证报告》§7.2.1 实测并**明确判定**：
//
//   > N ≥ 4 且位宽 ≥ 16 的不变量保持**未能证明**。
//   > 纯 SAT 路径：Bits<8> 4 秒 → Bits<12> >120 秒 → Bits<32> >240 秒（指数爆炸）。
//   > 根因是加法结合律/同余对 resolution 是指数难的。
//
// 本文件把它推到**真实 uint256**（256 位、4 账户）—— 纯 SAT 在此完全不可达。
// 词级重写层（`src/word.rs`）在 bit-blast 之前把两侧规范化为同一形，应**瞬间**判证。
//
// 这是「有界地址域 + 真实位宽」的最强组合：
//   * 账户数 N=4  → 多项式重结合（不只是两项相消）
//   * 位宽 256    → 与 OpenZeppelin 的 uint256 一致
//
// ## 注意
//
// 漏洞变体（负面对照）不放在本文件：在 256 位下让 SAT 去找反例本身就可能是
// 长时间搜索。该对照在 `tests/word.rs` 里用词级接口直接断言（`word_prove`
// 必须返回 `None`），既能锁定「不误证」，又不引入不确定的耗时。

// ---------------------------------------------------------------------------
// transfer(0 → 1, amount)：不变量保持
//   invAfter = ((b0-amount) + (b1+amount) + b2 + b3) == total
// 词级恒等式：(b0-amount)+(b1+amount) ≡ b0+b1  (mod 2^256) ⇒ invAfter ≡ invBefore
// ---------------------------------------------------------------------------
circuit ERC20Step4x256(
    b0: Bits<256>, b1: Bits<256>, b2: Bits<256>, b3: Bits<256>,
    total: Bits<256>, amount: Bits<256>
) -> (violation: Bit) {
    invBefore = (b0 + b1 + b2 + b3) == total;
    invAfter = (((b0 - amount) + (b1 + amount)) + b2 + b3) == total;
    violation = AND(invBefore, NOT(invAfter));
    return violation;
}

spec FCT.erc20.ERC20Step4x256 {
    precondition: true;
    postcondition: violation == 0;
    invariant: true;
}
