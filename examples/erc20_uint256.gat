// ============================================================================
// uint256 位宽的 ERC-20 算术核心
// ============================================================================
//
// 本文件把 ERC-20 的算术从 Bits<16> 提升到**真实 uint256 位宽**（与 OpenZeppelin
// 的 `uint256` 一致），对应 `_transfer` / `_mint` / `_burn` 中的余额运算。
//
// ## 设计说明：为什么规格是布尔判定
//
// 规格层（`spec`）的算术是 **u128** 语义，无法表示 `2^256`。因此在 256 位场景下
// 把**算术放进电路**，让电路输出 1 位的判定信号，规格只做布尔判定
// （`x == 1` / `x == 0`）。
//
// 证明力**不变** —— 仍然是全称量化：`x == 0` 被判 UNSAT 等价于
// "对**全部** 2^512 个输入组合，x 恒为 0"。我们只是把算术的表达位置从规格层
// 移到了电路层（电路是逐位的，对宽度没有限制）。
//
// ## 诚实的作用域
//
// 仍然只覆盖**纯算术**：无 storage、无 `mapping`、无 `msg.sender`、无事件、
// 无 `totalSupply` 全局不变量。见《GateLang ERC-20 形式化验证报告》。

// ---------------------------------------------------------------------------
// checked 减法（uint256）—— 等价于 OpenZeppelin 0.8+ 的 `a - b` 内建下溢检查
// ---------------------------------------------------------------------------
circuit Sub256(a: Bits<256>, b: Bits<256>) -> (ok: Bit, d: Bits<256>) {
    d = a - b;
    ok = a >= b;
    return (ok, d);
}

// **结构完全不同的等价判据**：无下溢 ⟺ 回绕后的差不超过被减数
// （a < b 时 a-b 回绕为 a-b+2^256 > a；a = b 时差为 0 ≤ a）
circuit Sub256Ref(a: Bits<256>, b: Bits<256>) -> (ok: Bit, d: Bits<256>) {
    d = a - b;
    ok = (a - b) <= a;
    return (ok, d);
}

// ---------------------------------------------------------------------------
// checked 加法（uint256）—— 等价于 OpenZeppelin 0.8+ 的 `a + b` 内建上溢检查
// ---------------------------------------------------------------------------
circuit Add256(a: Bits<256>, b: Bits<256>) -> (ok: Bit, s: Bits<256>) {
    s = a + b;
    ok = s >= a;
    return (ok, s);
}

// **独立判据**：无溢出 ⟺ a ≤ NOT(b)，即 a ≤ 2^256 - 1 - b
// （NOT 是逐位取反，天然给出 2^256-1-b，无需写下 256 位字面量）
circuit Add256Ref(a: Bits<256>, b: Bits<256>) -> (ok: Bit, s: Bits<256>) {
    s = a + b;
    ok = NOT(b) >= a;
    return (ok, s);
}

// ---------------------------------------------------------------------------
// transfer 的余额守恒（uint256）
//
// `newFrom + newTo == fromBal + toBal` 恒成立（成功或失败都成立）：
// 它只是 `- amount` 与 `+ amount` 在模 2^256 下相互抵消。
// 这是 ERC-20 最核心的安全不变量在**真实 uint256 位宽**下的形式。
// ---------------------------------------------------------------------------
circuit Transfer256Conservation(fromBal: Bits<256>, toBal: Bits<256>, amount: Bits<256>)
    -> (holds: Bit) {
    newFrom = fromBal - amount;
    newTo = toBal + amount;
    holds = (newFrom + newTo) == (fromBal + toBal);
    return holds;
}

// ---------------------------------------------------------------------------
// 正确实现：from 侧与 to 侧**都**做 checked 检查
//
// `bad` 表示"声称转账成功、但接收方余额反而减少"（凭空销毁代币）。
// 正确实现必须使 `bad` 恒为 0。
// ---------------------------------------------------------------------------
circuit Transfer256Safe(fromBal: Bits<256>, toBal: Bits<256>, amount: Bits<256>) -> (bad: Bit) {
    newTo = toBal + amount;
    ok = AND(fromBal >= amount, newTo >= toBal);
    bad = AND(ok, NOT(newTo >= toBal));
    return bad;
}

// ---------------------------------------------------------------------------
// 漏洞实现：**只检查 from 侧**，漏掉 to 侧加法溢出检查
// （模拟 Solidity 0.7 及更早的 unchecked 转账，或手写 unchecked 块）
// ---------------------------------------------------------------------------
circuit Transfer256Buggy(fromBal: Bits<256>, toBal: Bits<256>, amount: Bits<256>) -> (bad: Bit) {
    newTo = toBal + amount;
    ok = fromBal >= amount;
    bad = AND(ok, NOT(newTo >= toBal));
    return bad;
}

// ===========================================================================
// 形式化功能契约
//
// 256 位算术已在电路内完成，因此规格是布尔判定。每条都是**全称量化**命题。
// ===========================================================================

// --- C1：余额守恒恒成立（对全部 2^768 个输入组合）-------------------------
spec FCT.erc20.Transfer256Conservation {
    precondition: true;
    postcondition: holds == 1;
    invariant: true;
}

// --- C2：正确实现绝不存在"成功却使接收方余额减少"-------------------------
spec FCT.erc20.Transfer256Safe {
    precondition: true;
    postcondition: bad == 0;
    invariant: true;
}

// --- C3（应被驳倒）：漏洞实现违反同一属性 --------------------------------
// 当 fromBal >= amount（漏洞实现认为可转账）而 toBal + amount 溢出时，
// newTo 回绕变小，`bad` 变为 1。验证器必须给出反例。
spec FCT.erc20.Transfer256Buggy {
    precondition: true;
    postcondition: bad == 0;
    invariant: true;
}
